generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum UserRole {
  CUSTOMER
  AGENT
}

enum RequestPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum RequestStatus {
  NEW
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model User {
  id               String                 @id @default(cuid(2))
  email            String                 @unique
  displayName      String
  passwordHash     String
  role             UserRole               @default(CUSTOMER)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  createdRequests  ServiceRequest[]       @relation("RequestCustomer")
  assignedRequests ServiceRequest[]       @relation("RequestAssignee")
  statusChanges    RequestStatusHistory[] @relation("HistoryActor")
  refreshSessions  RefreshSession[]

  @@index([role, createdAt])
}

model RefreshSession {
  id          String    @id @default(cuid(2))
  userId      String
  tokenHash   String    @unique
  userAgent   String?
  ipAddress   String?
  expiresAt   DateTime
  revokedAt   DateTime?
  rotatedAt   DateTime?
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, expiresAt])
}

model ServiceRequest {
  id              String                 @id @default(cuid(2))
  customerId      String
  assignedAgentId String?
  title           String
  description     String
  priority        RequestPriority        @default(NORMAL)
  status          RequestStatus          @default(NEW)
  slaDueAt        DateTime
  respondedAt     DateTime?
  version         Int                    @default(0)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  customer        User                   @relation("RequestCustomer", fields: [customerId], references: [id], onDelete: Restrict)
  assignedAgent   User?                  @relation("RequestAssignee", fields: [assignedAgentId], references: [id], onDelete: Restrict)
  statusHistory   RequestStatusHistory[]

  @@index([customerId, status, createdAt])
  @@index([status, createdAt])
  @@index([assignedAgentId, status, updatedAt])
  @@index([status, slaDueAt])
}

model RequestStatusHistory {
  id         String        @id @default(cuid(2))
  requestId  String
  actorId    String
  fromStatus RequestStatus?
  toStatus   RequestStatus
  createdAt  DateTime      @default(now())
  request    ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  actor      User           @relation("HistoryActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([requestId, createdAt])
  @@index([actorId, createdAt])
}